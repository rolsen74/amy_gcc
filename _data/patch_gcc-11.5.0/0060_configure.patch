diff -rupN gcc.orig/libiberty/configure gcc.work/libiberty/configure
--- gcc.orig/libiberty/configure	2025-12-08 09:27:43.990432056 +0100
+++ gcc.work/libiberty/configure	2025-12-08 09:27:46.722432170 +0100
@@ -6566,6 +6566,17 @@ if test -z "${setobjs}"; then
     ac_cv_func_getpagesize=yes
     ;;
 
+   *-*-amigaos*)
+     # current newlib lacks unsetenv(), so we custom versions
+     # of setenv() and unsetenv().
+     case " $LIBOBJS " in
+   *" setenv-amigaos.$ac_objext "* ) ;;
+   *) LIBOBJS="$LIBOBJS setenv-amigaos.$ac_objext"
+  ;;
+ esac
+
+     ;;
+
   hppa*-*-hpux*)
     # Replace system snprintf and vsnprintf with libiberty implementations.
     case " $LIBOBJS " in
@@ -7363,6 +7374,7 @@ case "${host}" in
      *-*-mingw* | *-*-winnt*)	pexecute=pex-win32  ;;
      *-*-msdosdjgpp*)		pexecute=pex-djgpp  ;;
      *-*-msdos*)		pexecute=pex-msdos  ;;
+     *-*-amigaos*)		pexecute=pex-amigaos;;
      *)				pexecute=pex-unix   ;;
 esac
