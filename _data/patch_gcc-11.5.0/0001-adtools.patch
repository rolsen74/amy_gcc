+++ gcc.work/gcc/config/rs6000/rs6000.h	2025-12-08 09:27:46.362432155 +0100
@@ -2613,6 +2613,9 @@ while (0)
     }									\
   while (0)
 
+/* Used by amigaos port */
+void rs6000_va_start (tree valist, rtx nextarg);
