diff -rupN gcc.orig/libstdc++-v3/config/os/amigaos/ctype_inline.h gcc.work/libstdc++-v3/config/os/amigaos/ctype_inline.h
--- gcc.orig/libstdc++-v3/config/os/amigaos/ctype_inline.h	1970-01-01 01:00:00.000000000 +0100
+++ gcc.work/libstdc++-v3/config/os/amigaos/ctype_inline.h	2025-12-08 09:27:46.710432169 +0100
@@ -0,0 +1,173 @@
+// Locale support -*- C++ -*-
+
+// Copyright (C) 2000-2021 Free Software Foundation, Inc.
+//
